# DATABASE
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/fashion-shop?retryWrites=true&w=majority

# SERVER
PORT=5000
NODE_ENV=development

# TELEGRAM BOT
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_WEBHOOK_TOKEN=your_webhook_token
BOT_USERNAME=your_bot_username

# JWT
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRE=7d

# CLOUDINARY
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# PAYMENT (Payme, Click, etc.)
PAYME_MERCHANT_ID=your_payme_merchant_id
PAYME_SECRET_KEY=your_payme_secret_key

# TELEGRAM MINI APP
TELEGRAM_APP_SECRET=your_app_secret
FRONTEND_URL=http://localhost:3000

# ADMIN
ADMIN_PASSWORD=admin_password_hash
